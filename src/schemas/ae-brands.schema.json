{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Automation Exercise brand list",
  "type": "object",
  "required": ["responseCode", "brands"],
  "properties": {
    "responseCode": { "const": 200 },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "brand"],
        "properties": { "id": { "type": "integer" }, "brand": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
